{
"unserialzed": {
	 	"prefix": "uns",
	 	"body": [
	 		"$$1 = unserialize(base64_decode($$_REQUEST['$2']));"
	 	],
	 	"description": "Unserialize"
	},

	"serialized": {
	 	"prefix": "seri",
	 	"body": [
	 		"base64_encode(serialize($1));"
	 	],
	 	"description": "Serialized"
	},

	"isset": {
		"prefix": "iss",
		"body": [
			"if (!isset($$_REQUEST['$1'])) {",
        	"$2=[];",
    		"}else{",
			"$3=unserialize(base64_decode($$_REQUEST['$4']));",
			"$5[$_REQUEST['$6']] = $_REQUEST['$7'];",
    		"}"
		]
	}

}